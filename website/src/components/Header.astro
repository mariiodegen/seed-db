---
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const isDocs = currentPath.startsWith("/docs");
const base = import.meta.env.BASE_URL;
---

<header class="surface-dark-metal sticky top-0 z-50 border-b border-[#2c3036]/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href={base} class="flex items-center gap-3 group">
        <Logo size={28} isDark={true} />
        <span class="font-mono font-bold text-lg tracking-tight text-white group-hover:text-[#c9ced3] transition-colors">
          seed-db
        </span>
      </a>

      {isDocs ? (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-semibold bg-white/10 text-white border border-white/20">
          docs
        </span>
      ) : (
        <span class="hidden sm:inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono text-[#9aa1a8] bg-[#15171b]/80 border border-[#2c3036]">
          Pre-release. The npm name is reserved.
        </span>
      )}
    </div>

    <nav class="flex items-center gap-6">
      <a
        href={base}
        class={`text-sm font-mono transition-colors ${!isDocs ? "text-white font-bold" : "text-[#9aa1a8] hover:text-white"}`}
      >
        Home
      </a>
      <a
        href={`${base}docs`}
        class={`text-sm font-mono transition-colors ${isDocs ? "text-white font-bold" : "text-[#9aa1a8] hover:text-white"}`}
      >
        Docs
      </a>
      <a
        href={`${base}#how-it-works`}
        class="hidden md:inline-block text-sm font-mono text-[#9aa1a8] hover:text-white transition-colors"
      >
        How it works
      </a>
      <a
        href={`${base}#examples`}
        class="hidden sm:inline-block text-sm font-mono text-[#9aa1a8] hover:text-white transition-colors"
      >
        Examples
      </a>
      <a
        href={`${base}#ci`}
        class="hidden sm:inline-block text-sm font-mono text-[#9aa1a8] hover:text-white transition-colors"
      >
        CI
      </a>
      <a
        href="https://github.com/mariiodegen/seed-db"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-[#f4f6f8] bg-[#1b1d22] hover:bg-[#2a2d33] border border-[#454a52] px-3 py-1.5 rounded-md transition-all shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
