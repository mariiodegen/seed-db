---
---

<div class="surface-panel p-6 shadow-xl font-mono text-sm" id="kahn-widget">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-[#9aa1a8]/60 gap-4">
    <div>
      <div class="text-xs text-[#4a4f56] uppercase tracking-wider mb-1 font-bold">Topological Sort Simulation</div>
      <div class="text-[#0a0a0a] font-bold text-base">Kahn's Algorithm Rounds</div>
    </div>

    <!-- Stepper Controls (tap targets >= 44px) -->
    <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
      <button
        data-step="1"
        class="kahn-step-btn active min-h-[44px] min-w-[44px] px-3.5 py-1.5 rounded text-xs font-mono font-bold transition-all flex items-center justify-center"
      >
        1
      </button>
      <button
        data-step="2"
        class="kahn-step-btn min-h-[44px] min-w-[44px] px-3.5 py-1.5 rounded text-xs font-mono font-bold transition-all flex items-center justify-center"
      >
        2
      </button>
      <button
        data-step="3"
        class="kahn-step-btn min-h-[44px] min-w-[44px] px-3.5 py-1.5 rounded text-xs font-mono font-bold transition-all flex items-center justify-center"
      >
        3
      </button>
      <button
        data-step="4"
        class="kahn-step-btn min-h-[44px] min-w-[44px] px-3.5 py-1.5 rounded text-xs font-mono font-bold transition-all flex items-center justify-center"
      >
        4
      </button>
      <button
        id="kahn-play-pause-btn"
        class="ml-1 sm:ml-2 min-h-[44px] px-3.5 py-1.5 rounded text-xs font-mono font-bold text-[#0a0a0a] bg-[var(--btn-metal)] border border-[#8c939b] flex items-center gap-1.5 transition-all shadow-sm active:scale-95 hover:brightness-105"
      >
        <span id="play-pause-icon">⏸</span>
        <span id="play-pause-label">Pause</span>
      </button>
    </div>
  </div>

  <!-- Table Insertion List -->
  <div class="py-5 space-y-2.5" id="kahn-table-list">
    <!-- employees -->
    <div
      id="item-employees"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#e4e8ec] text-[#4a4f56] border border-[#c7ccd2]">Round 1</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">employees</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">No parents. manager_id stays empty for now.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        inserted
      </span>
    </div>

    <!-- products -->
    <div
      id="item-products"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#e4e8ec] text-[#4a4f56] border border-[#c7ccd2]">Round 1</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">products</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">No parents.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        inserted
      </span>
    </div>

    <!-- users -->
    <div
      id="item-users"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#e4e8ec] text-[#4a4f56] border border-[#c7ccd2]">Round 1</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">users</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">No parents.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        inserted
      </span>
    </div>

    <!-- orders -->
    <div
      id="item-orders"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#e4e8ec] text-[#4a4f56] border border-[#c7ccd2]">Round 2</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">orders</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">Needs users, which are in.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        inserting now
      </span>
    </div>

    <!-- order_items -->
    <div
      id="item-order-items"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#e4e8ec] text-[#4a4f56] border border-[#c7ccd2]">Round 3</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">order_items</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">Needs orders and products, both in.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        waiting
      </span>
    </div>

    <!-- patch employees -->
    <div
      id="item-patch-employees"
      class="kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm"
    >
      <div class="flex items-center gap-3">
        <span class="round-badge text-xs px-2.5 py-0.5 rounded font-mono font-bold bg-[#d8dde2] text-[#0a0a0a] border border-[#9aa1a8]">Last</span>
        <div>
          <span class="font-bold text-[#0a0a0a]">patch employees</span>
          <span class="text-xs text-[#4a4f56] block sm:inline sm:ml-2">One update fills manager_id.</span>
        </div>
      </div>
      <span class="status-badge text-xs px-3 py-1 rounded font-mono font-bold">
        waiting
      </span>
    </div>
  </div>

  <!-- Dynamic Caption Footer -->
  <div class="p-4 bg-[#f4f6f8] rounded-lg border border-[#c7ccd2] flex items-center gap-3 shadow-inner">
    <span class="w-2.5 h-2.5 rounded-full bg-[#0a0a0a]"></span>
    <div id="kahn-caption" class="text-xs text-[#0a0a0a] font-mono font-semibold">
      Round 2: orders needs users, and users are now in.
    </div>
  </div>
</div>

<style>
  /* Step buttons */
  .kahn-step-btn.active {
    background: var(--btn-dark);
    color: #ffffff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    border: 1px solid #3a3f47;
  }

  .kahn-step-btn:not(.active) {
    background: var(--btn-metal);
    color: var(--ink);
    border: 1px solid #8c939b;
  }

  .kahn-step-btn:not(.active):hover {
    filter: brightness(1.07);
  }
</style>

<script>
  function setupKahnAnimator() {
    const stepBtns = document.querySelectorAll('.kahn-step-btn');
    const playPauseBtn = document.getElementById('kahn-play-pause-btn');
    const playPauseIcon = document.getElementById('play-pause-icon');
    const playPauseLabel = document.getElementById('play-pause-label');
    const caption = document.getElementById('kahn-caption');

    const items = {
      emp: document.getElementById('item-employees'),
      prod: document.getElementById('item-products'),
      users: document.getElementById('item-users'),
      orders: document.getElementById('item-orders'),
      items: document.getElementById('item-order-items'),
      patch: document.getElementById('item-patch-employees'),
    };

    let currentStep = 2;
    let isPlaying = true;
    let intervalId: any = null;

    const stepConfigs = {
      1: {
        caption: "Round 1: tables with 0 parents (employees, products, users) are inserted simultaneously.",
        states: {
          emp: 'inserting',
          prod: 'inserting',
          users: 'inserting',
          orders: 'waiting',
          items: 'waiting',
          patch: 'waiting',
        }
      },
      2: {
        caption: "Round 2: orders needs users, and users are now in.",
        states: {
          emp: 'inserted',
          prod: 'inserted',
          users: 'inserted',
          orders: 'inserting',
          items: 'waiting',
          patch: 'waiting',
        }
      },
      3: {
        caption: "Round 3: order_items needs orders and products, both now in.",
        states: {
          emp: 'inserted',
          prod: 'inserted',
          users: 'inserted',
          orders: 'inserted',
          items: 'inserting',
          patch: 'waiting',
        }
      },
      4: {
        caption: "Last pass: One batch UPDATE patches employees.manager_id with real parent keys.",
        states: {
          emp: 'inserted',
          prod: 'inserted',
          users: 'inserted',
          orders: 'inserted',
          items: 'inserted',
          patch: 'inserting',
        }
      }
    };

    function setBadge(el: HTMLElement | null, status: 'inserted' | 'inserting' | 'waiting') {
      if (!el) return;
      const badge = el.querySelector('.status-badge');
      if (!badge) return;

      if (status === 'inserted') {
        badge.className = 'status-badge text-xs px-3 py-1 rounded font-mono font-bold bg-[#e4e7ea] text-[#4a4f56] border border-[#c7ccd2]';
        badge.textContent = 'inserted';
        el.className = 'kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#c7ccd2] bg-[#ffffff]/80 transition-all shadow-sm';
      } else if (status === 'inserting') {
        badge.className = 'status-badge text-xs px-3 py-1 rounded font-mono font-bold bg-[var(--btn-dark)] text-white border border-[#3a3f47] shadow';
        badge.textContent = 'inserting now';
        el.className = 'kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#6b727a] bg-[#ffffff] transition-all shadow-md';
      } else {
        badge.className = 'status-badge text-xs px-3 py-1 rounded font-mono font-bold bg-[#f4f6f8] text-[#9aa1a8] border border-[#e4e8ec]';
        badge.textContent = 'waiting';
        el.className = 'kahn-item flex items-center justify-between p-3.5 rounded-lg border border-[#e4e8ec] bg-[#f8fafc]/50 opacity-70 transition-all';
      }
    }

    function renderStep(step: number) {
      currentStep = step;
      const config = (stepConfigs as any)[step];
      if (!config) return;

      if (caption) caption.textContent = config.caption;

      stepBtns.forEach(btn => {
        const s = parseInt(btn.getAttribute('data-step') || '0', 10);
        if (s === step) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      setBadge(items.emp, config.states.emp);
      setBadge(items.prod, config.states.prod);
      setBadge(items.users, config.states.users);
      setBadge(items.orders, config.states.orders);
      setBadge(items.items, config.states.items);
      setBadge(items.patch, config.states.patch);
    }

    stepBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const step = parseInt(btn.getAttribute('data-step') || '1', 10);
        renderStep(step);
      });
    });

    function startAutoPlay() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        let next = currentStep + 1;
        if (next > 4) next = 1;
        renderStep(next);
      }, 3500);
      isPlaying = true;
      if (playPauseIcon) playPauseIcon.textContent = '⏸';
      if (playPauseLabel) playPauseLabel.textContent = 'Pause';
    }

    function stopAutoPlay() {
      if (intervalId) clearInterval(intervalId);
      intervalId = null;
      isPlaying = false;
      if (playPauseIcon) playPauseIcon.textContent = '▶';
      if (playPauseLabel) playPauseLabel.textContent = 'Play';
    }

    if (playPauseBtn) {
      playPauseBtn.addEventListener('click', () => {
        if (isPlaying) {
          stopAutoPlay();
        } else {
          startAutoPlay();
        }
      });
    }

    // Initial render
    renderStep(2);
    startAutoPlay();
  }

  setupKahnAnimator();
  document.addEventListener('astro:page-load', setupKahnAnimator);
</script>
