---
interface Props {
  text?: string;
  className?: string;
}

const { text = "IN PLAIN WORDS", className = "" } = Astro.props;
---

<div class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium tracking-wider uppercase bg-emerald-950/40 text-emerald-400 border border-emerald-500/30 ${className}`}>
  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
  <span>{text}</span>
</div>
