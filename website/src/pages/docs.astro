                  <tr class="hover:bg-[#ffffff]/50 transition-colors">
                    <td class="py-3.5 px-4 font-mono font-bold">exit</td>
                    <td class="py-3.5 px-4 text-[#4a4f56]">The exit code the CLI returns.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Terminal vs JSON Examples in Silver Frames -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 font-mono text-xs">
              <div class="silver-frame">
                <div class="bg-[#0c0d10] border border-[#2c3036] rounded-[18px] p-5 space-y-2 text-[#c7ccd2]">
