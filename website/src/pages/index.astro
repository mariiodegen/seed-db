---
import Layout from '../layouts/Layout.astro';
import PillBadge from '../components/PillBadge.astro';
import TerminalWidget from '../components/TerminalWidget.astro';
import KahnAnimator from '../components/KahnAnimator.astro';
import ExamplesWidget from '../components/ExamplesWidget.astro';
---

<Layout title="seed-db — Seeding you can trust in CI" currentPath="/">
  <!-- 1. HERO SECTION (Dark Metal) -->
  <section class="surface-dark-metal pt-14 pb-20 md:pt-20 md:pb-28 border-b border-[#2c3036]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded text-xs font-mono font-semibold bg-[#15171b] text-[#c7ccd2] border border-[#3a3f47]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#8a9199]"></span>
            <span>Pre-release. The npm name is reserved.</span>
          </div>

          <h1 class="font-mono text-4xl sm:text-5xl lg:text-[54px] font-bold tracking-tight leading-[1.15]">
            <span class="text-[#8a9199] select-none">$ </span>
            <span class="chrome-headline">Seeding you can trust in CI.</span>
          </h1>

          <p class="font-sans text-lg text-[#c7ccd2] leading-relaxed max-w-xl">
            seed-db reads your PostgreSQL schema, fills every table in the right order with realistic fake data, and commits all of it or none of it. When something fails, the error names the fix.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href={`${import.meta.env.BASE_URL}docs`} class="btn-metal">
              Read the docs
            </a>
            <a href="#examples" class="btn-dark">
              See examples
            </a>
          </div>
        </div>

        <!-- Hero Terminal Widget -->
        <div class="lg:col-span-6">
          <TerminalWidget />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROMISES (Aluminium) -->
  <section class="surface-aluminium py-20 border-b border-[#c7ccd2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" isDark={false} />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-[#0a0a0a] tracking-tight">
          A seeding tool should behave the same way every time.
        </h2>
        <p class="font-sans text-base sm:text-lg text-[#4a4f56] leading-relaxed">
          It either fills your database properly or leaves it untouched. It never leaves a half-finished mess.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="surface-panel p-7 space-y-3 card-lift">
          <div class="w-8 h-8 rounded bg-[#e4e8ec] border border-[#9aa1a8] flex items-center justify-center text-[#0a0a0a] font-mono text-xs font-bold">
            01
          </div>
          <h3 class="font-mono text-lg font-bold text-[#0a0a0a]">
            All or nothing
          </h3>
          <p class="font-sans text-sm text-[#4a4f56] leading-relaxed">
            Every run is one transaction. If anything fails, it rolls back and your tables stay exactly as they were.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="surface-panel p-7 space-y-3 card-lift">
          <div class="w-8 h-8 rounded bg-[#e4e8ec] border border-[#9aa1a8] flex items-center justify-center text-[#0a0a0a] font-mono text-xs font-bold">
            02
          </div>
          <h3 class="font-mono text-lg font-bold text-[#0a0a0a]">
            Same seed, same data
          </h3>
          <p class="font-sans text-sm text-[#4a4f56] leading-relaxed">
            The same <span class="code-chip">--seed</span> gives identical rows in the same order, so a failing test reproduces on every machine.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="surface-panel p-7 space-y-3 card-lift">
          <div class="w-8 h-8 rounded bg-[#e4e8ec] border border-[#9aa1a8] flex items-center justify-center text-[#0a0a0a] font-mono text-xs font-bold">
            03
          </div>
          <h3 class="font-mono text-lg font-bold text-[#0a0a0a]">
            Errors that name the fix
          </h3>
          <p class="font-sans text-sm text-[#4a4f56] leading-relaxed">
            Each error carries a stable code, the table and column, the cause, and one concrete fix. Read it in your terminal or as JSON.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. QUICK START (Light Aluminium) -->
  <section class="surface-aluminium-light py-20 border-b border-[#c7ccd2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-3 max-w-3xl">
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-[#0a0a0a] tracking-tight">
          Three commands to your first seed.
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#4a4f56] leading-relaxed">
          This is how version 1 is designed to work. Version 0.0.1 only reserves the package name, so there is nothing to install yet.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="surface-panel p-6 space-y-4 flex flex-col justify-between card-lift">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-[#0a0a0a] bg-[#e4e8ec] border border-[#9aa1a8] px-2 py-0.5 rounded">
              STEP 1
            </span>
            <h3 class="font-mono text-base font-bold text-[#0a0a0a]">Point it at a database</h3>
            <p class="font-sans text-xs text-[#4a4f56] leading-relaxed">
              Answer two questions: the database URL and how many rows per table. It writes <span class="code-chip">seed.config.ts</span> and <span class="code-chip">.env.example</span>.
            </p>
          </div>

          <div class="rounded-lg bg-[#0c0d10] p-3 border border-[#2c3036] flex items-center justify-between font-mono text-xs text-white">
            <span><span class="text-[#8a9199] select-none">$ </span>seed-db init</span>
            <button
              class="step-copy-btn h-[32px] px-3 rounded text-xs font-mono font-bold text-white bg-[#1b1d22] hover:bg-[#2a2d33] border border-[#454a52] transition-colors"
              data-cmd="seed-db init"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="surface-panel p-6 space-y-4 flex flex-col justify-between card-lift">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-[#0a0a0a] bg-[#e4e8ec] border border-[#9aa1a8] px-2 py-0.5 rounded">
              STEP 2
            </span>
            <h3 class="font-mono text-base font-bold text-[#0a0a0a]">Look before you seed</h3>
            <p class="font-sans text-xs text-[#4a4f56] leading-relaxed">
              See every table, its relationships, the insert order, and which generator each column will use.
            </p>
          </div>

          <div class="rounded-lg bg-[#0c0d10] p-3 border border-[#2c3036] flex items-center justify-between font-mono text-xs text-white">
            <span><span class="text-[#8a9199] select-none">$ </span>seed-db inspect</span>
            <button
              class="step-copy-btn h-[32px] px-3 rounded text-xs font-mono font-bold text-white bg-[#1b1d22] hover:bg-[#2a2d33] border border-[#454a52] transition-colors"
              data-cmd="seed-db inspect"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="surface-panel p-6 space-y-4 flex flex-col justify-between card-lift">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-[#0a0a0a] bg-[#e4e8ec] border border-[#9aa1a8] px-2 py-0.5 rounded">
              STEP 3
            </span>
            <h3 class="font-mono text-base font-bold text-[#0a0a0a]">Seed it</h3>
            <p class="font-sans text-xs text-[#4a4f56] leading-relaxed">
              Generate the data and insert it in one transaction. Add <span class="code-chip">--check</span> to try it and roll it back.
            </p>
          </div>

          <div class="rounded-lg bg-[#0c0d10] p-3 border border-[#2c3036] flex items-center justify-between font-mono text-xs text-white">
            <span><span class="text-[#8a9199] select-none">$ </span>seed-db run</span>
            <button
              class="step-copy-btn h-[32px] px-3 rounded text-xs font-mono font-bold text-white bg-[#1b1d22] hover:bg-[#2a2d33] border border-[#454a52] transition-colors"
              data-cmd="seed-db run"
            >
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS (Dark Metal) -->
  <section id="how-it-works" class="surface-dark-metal py-20 border-b border-[#2c3036]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- 5-Stage Heading -->
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" isDark={true} />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold tracking-tight">
          <span class="chrome-headline">Five stages, one direction.</span>
        </h2>
        <p class="font-sans text-base text-[#c7ccd2] leading-relaxed">
          Only the first read of the schema and the final write touch your database. Everything in between is plain logic that gives the same answer every run.
        </p>
        <p class="font-sans text-xs text-[#9aa1a8] italic">
          It looks at how your tables connect, works out which ones must be filled first, then fills them from the top down.
        </p>
      </div>

      <!-- 5 Stages Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Stage 1 -->
        <div class="rounded-xl border border-[#3a3f47] bg-[#15171b] p-5 space-y-3 relative flex flex-col justify-between shadow-lg">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-white">1</div>
            <h4 class="font-mono text-sm font-bold text-white">Load config</h4>
            <p class="font-sans text-xs text-[#9aa1a8] leading-relaxed">
              Flags, <span class="text-[#c7ccd2]">seed.config.ts</span> and <span class="text-[#c7ccd2]">DATABASE_URL</span> become one set of options. A bad value stops here.
            </p>
          </div>
          <div class="hidden lg:block text-[#6b727a] font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 2 -->
        <div class="rounded-xl border border-[#3a3f47] bg-[#15171b] p-5 space-y-3 relative flex flex-col justify-between shadow-lg">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-white">2</div>
            <h4 class="font-mono text-sm font-bold text-white">Introspect</h4>
            <p class="font-sans text-xs text-[#9aa1a8] leading-relaxed">
              Read-only catalog queries turn tables, columns, keys and enums into one schema object.
            </p>
          </div>
          <div class="hidden lg:block text-[#6b727a] font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 3 -->
        <div class="rounded-xl border border-[#3a3f47] bg-[#15171b] p-5 space-y-3 relative flex flex-col justify-between shadow-lg">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-white">3</div>
            <h4 class="font-mono text-sm font-bold text-white">Order tables</h4>
            <p class="font-sans text-xs text-[#9aa1a8] leading-relaxed">
              Parents go before children. Ties break alphabetically, so the order never changes.
            </p>
          </div>
          <div class="hidden lg:block text-[#6b727a] font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 4 -->
        <div class="rounded-xl border border-[#3a3f47] bg-[#15171b] p-5 space-y-3 relative flex flex-col justify-between shadow-lg">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-white">4</div>
            <h4 class="font-mono text-sm font-bold text-white">Generate</h4>
            <p class="font-sans text-xs text-[#9aa1a8] leading-relaxed">
              Each column gets a generator once: your rule, then a foreign key, then a name match, then its type.
            </p>
          </div>
          <div class="hidden lg:block text-[#6b727a] font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 5 -->
        <div class="rounded-xl border border-[#3a3f47] bg-[#15171b] p-5 space-y-3 relative flex flex-col justify-between shadow-lg">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-white">5</div>
            <h4 class="font-mono text-sm font-bold text-white">Execute</h4>
            <p class="font-sans text-xs text-[#9aa1a8] leading-relaxed">
              Insert in batches inside one transaction, then fill any deferred links in a final patch pass.
            </p>
          </div>
          <div class="hidden lg:block text-white font-mono text-right text-xs">✔</div>
        </div>
      </div>

      <!-- Kahn's Algorithm Animator -->
      <div class="pt-8 space-y-6">
        <div class="space-y-2 max-w-2xl">
          <h3 class="font-mono text-xl sm:text-2xl font-bold text-white tracking-tight">
            Watch the insert order
          </h3>
          <p class="font-sans text-sm text-[#9aa1a8] leading-relaxed">
            Five tables. <span class="text-[#f4f6f8] font-mono">employees</span> points at itself, because a manager is also an employee, so it goes in first with <span class="text-[#f4f6f8] font-mono">manager_id</span> empty. One update fills it at the end.
          </p>
        </div>

        <KahnAnimator />
      </div>
    </div>
  </section>

  <!-- 5. EXAMPLES (Aluminium) -->
  <section id="examples" class="surface-aluminium py-20 border-b border-[#c7ccd2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3 max-w-3xl">
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-[#0a0a0a] tracking-tight">
          Examples you can copy.
        </h2>
        <p class="font-sans text-base text-[#4a4f56] leading-relaxed">
          Pick the situation you are in. Each one is a single command or a short file.
        </p>
      </div>

      <ExamplesWidget />
    </div>
  </section>

  <!-- 6. CI & EXIT CODES (Dark Metal) -->
  <section id="ci" class="surface-dark-metal py-20 border-b border-[#2c3036]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" isDark={true} />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold tracking-tight">
          <span class="chrome-headline">Prove a schema change did not break seeding.</span>
        </h2>
        <p class="font-sans text-base text-[#c7ccd2] leading-relaxed">
          Nothing prompts when output is not a terminal, exit codes are fixed, and every result and error can be printed as JSON for your pipeline to read.
        </p>
        <p class="font-sans text-xs text-[#9aa1a8] italic">
          Your automated checks can run it and know straight away whether seeding still works.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Terminal & JSON Block -->
        <div class="lg:col-span-6 space-y-4 font-mono text-xs">
          <div class="silver-frame">
            <div class="bg-[#0c0d10] border border-[#2c3036] rounded-[18px] p-5 space-y-3 text-white">
              <div class="text-[#8a9199] text-[11px]">terminal</div>
              <div class="font-bold">
                seed-db run --check --seed 1 --format json
              </div>
            </div>
          </div>

          <div class="silver-frame">
            <div class="bg-[#0c0d10] border border-[#2c3036] rounded-[18px] p-5 space-y-2 text-[#c7ccd2]">
              <div class="text-[#8a9199] text-[11px]">JSON response on error</div>
              <pre class="overflow-x-auto leading-relaxed text-[#f4f6f8]">&#123;
  "error": &#123;
    "code": "E_UNSUPPORTED_TYPE",
    "where": "orders.total",
    "fix": "Add a rule for orders.total in seed.config.ts",
    "exit": 3
  &#125;
&#125;</pre>
            </div>
          </div>
        </div>

        <!-- Right: Exit Codes Table -->
        <div class="lg:col-span-6 surface-panel overflow-hidden">
          <div class="px-5 py-3 border-b border-[#9aa1a8] bg-gradient-to-b from-[#ffffff] to-[#cfd4da] font-mono text-xs font-bold text-[#0a0a0a] uppercase tracking-wider">
            Exit Codes
          </div>
          <div class="divide-y divide-[#b9c0c8] font-mono text-xs">
            <div class="p-4 flex items-start gap-4 hover:bg-[#ffffff]/50 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-[#0a0a0a] text-white">0</span>
              <span class="font-sans text-[#0a0a0a] font-medium">Success, or a clean dry run</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-[#ffffff]/50 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-[#3a3f47] text-white">1</span>
              <span class="font-sans text-[#0a0a0a] font-medium">Runtime or database error; transaction rolled back</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-[#ffffff]/50 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-[#4a4f56] text-white">2</span>
              <span class="font-sans text-[#0a0a0a] font-medium">Usage or config error: bad flag, missing URL, invalid config</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-[#ffffff]/50 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-[#6b727a] text-white">3</span>
              <span class="font-sans text-[#0a0a0a] font-medium">Schema problem: unbreakable circular dependency, unsupported required column type</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. VERSION 1 SCOPE (Light Aluminium) -->
  <section class="surface-aluminium-light py-20 border-b border-[#c7ccd2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" isDark={false} />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-[#0a0a0a] tracking-tight">
          Version 1 is small on purpose.
        </h2>
        <p class="font-sans text-base text-[#4a4f56] leading-relaxed">
          PostgreSQL only, one schema per run. The first release does a few things and does them safely.
        </p>
        <p class="font-sans text-xs text-[#6b727a] italic">
          Version 1 covers the common cases first. The rest comes once real schemas need it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- In Version 1 -->
        <div class="surface-panel p-6 space-y-4 card-lift">
          <div class="flex items-center justify-between pb-3 border-b border-[#9aa1a8]">
            <h3 class="font-mono text-base font-bold text-[#0a0a0a]">In version 1</h3>
            <span class="text-xs font-mono font-bold text-[#0a0a0a] bg-[#e4e8ec] px-2.5 py-0.5 rounded border border-[#9aa1a8]">Ready</span>
          </div>

          <ul class="space-y-2.5 font-sans text-xs text-[#0a0a0a]">
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>Single-column foreign keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>Type mapping and a short list of name matches</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>One transaction per run (all-or-nothing atomicity)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span><span class="code-chip">--dry-run</span>, <span class="code-chip">--check</span> and <span class="code-chip">--out</span></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>Snapshots from <span class="code-chip">inspect --json</span></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>Circular tables, filled in afterwards (2-phase patch pass)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono font-bold">✔</span>
              <span>Errors with a code, location, cause, and concrete fix</span>
            </li>
          </ul>
        </div>

        <!-- Later -->
        <div class="surface-panel p-6 space-y-4 card-lift opacity-85">
          <div class="flex items-center justify-between pb-3 border-b border-[#9aa1a8]">
            <h3 class="font-mono text-base font-bold text-[#4a4f56]">Later</h3>
            <span class="text-xs font-mono font-bold text-[#4a4f56] bg-[#e4e8ec] px-2.5 py-0.5 rounded border border-[#c7ccd2]">Roadmap</span>
          </div>

          <ul class="space-y-2.5 font-sans text-xs text-[#4a4f56]">
            <li class="flex items-center gap-2">
              <span class="font-mono">•</span>
              <span>Multi-column foreign keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono">•</span>
              <span>Reading a schema file, with an in-process Postgres</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono">•</span>
              <span>More name matches and dictionary heuristics</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono">•</span>
              <span><span class="code-chip">--truncate</span> and resume after failure</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="font-mono">•</span>
              <span>MySQL and SQLite dialect adapters</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupStepCopyButtons() {
    const btns = document.querySelectorAll('.step-copy-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-cmd');
        if (cmd) {
          navigator.clipboard.writeText(cmd);
          const orig = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1500);
        }
      });
    });
  }

  setupStepCopyButtons();
  document.addEventListener('astro:page-load', setupStepCopyButtons);
</script>
