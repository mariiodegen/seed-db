---
import Layout from '../layouts/Layout.astro';
import PillBadge from '../components/PillBadge.astro';
import TerminalWidget from '../components/TerminalWidget.astro';
import KahnAnimator from '../components/KahnAnimator.astro';
import ExamplesWidget from '../components/ExamplesWidget.astro';
---

<Layout title="seed-db — Seeding you can trust in CI" currentPath="/">
  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Pre-release. The npm name is reserved.</span>
          </div>

          <h1 class="font-mono text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
            <span class="text-emerald-400 select-none">$ </span>Seeding you can trust in CI.
          </h1>

          <p class="font-sans text-lg sm:text-xl text-slate-300 leading-relaxed max-w-xl">
            seed-db reads your PostgreSQL schema, fills every table in the right order with realistic fake data, and commits all of it or none of it. When something fails, the error names the fix.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/docs"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-sm font-mono font-semibold text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition-all shadow-lg shadow-emerald-500/20 active:scale-95"
            >
              Read the docs
            </a>
            <a
              href="#examples"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-sm font-mono font-medium text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-600 transition-all active:scale-95"
            >
              See examples
            </a>
          </div>
        </div>

        <!-- Hero Terminal Widget -->
        <div class="lg:col-span-6">
          <TerminalWidget />
        </div>
      </div>
    </div>
  </section>

  <!-- HIGH LEVEL INVARIANTS SECTION -->
  <section class="py-20 border-t border-slate-800/80 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          A seeding tool should behave the same way every time.
        </h2>
        <p class="font-sans text-base sm:text-lg text-slate-400 leading-relaxed">
          It either fills your database properly or leaves it untouched. It never leaves a half-finished mess.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="rounded-xl border border-slate-800/80 bg-[#090d16] p-7 space-y-3 relative overflow-hidden group hover:border-emerald-500/40 transition-colors shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono text-sm font-bold">
            01
          </div>
          <h3 class="font-mono text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">
            All or nothing
          </h3>
          <p class="font-sans text-sm text-slate-400 leading-relaxed">
            Every run is one transaction. If anything fails, it rolls back and your tables stay exactly as they were.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="rounded-xl border border-slate-800/80 bg-[#090d16] p-7 space-y-3 relative overflow-hidden group hover:border-emerald-500/40 transition-colors shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono text-sm font-bold">
            02
          </div>
          <h3 class="font-mono text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">
            Same seed, same data
          </h3>
          <p class="font-sans text-sm text-slate-400 leading-relaxed">
            The same <code class="px-1.5 py-0.5 rounded text-xs bg-slate-800 text-slate-300 font-mono">--seed</code> gives identical rows in the same order, so a failing test reproduces on every machine.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="rounded-xl border border-slate-800/80 bg-[#090d16] p-7 space-y-3 relative overflow-hidden group hover:border-emerald-500/40 transition-colors shadow-lg">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono text-sm font-bold">
            03
          </div>
          <h3 class="font-mono text-lg font-bold text-white group-hover:text-emerald-400 transition-colors">
            Errors that name the fix
          </h3>
          <p class="font-sans text-sm text-slate-400 leading-relaxed">
            Each error carries a stable code, the table and column, the cause, and one concrete fix. Read it in your terminal or as JSON.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-STEP SETUP FUNNEL -->
  <section class="py-20 border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-3 max-w-3xl">
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Three commands to your first seed.
        </h2>
        <p class="font-sans text-sm sm:text-base text-slate-400 leading-relaxed">
          This is how version 1 is designed to work. Version 0.0.1 only reserves the package name, so there is nothing to install yet.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-6 space-y-4 flex flex-col justify-between shadow-lg">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
              STEP 1
            </span>
            <h3 class="font-mono text-lg font-bold text-white">Point it at a database</h3>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Answer two questions: the database URL and how many rows per table. It writes <code class="text-slate-300 font-mono">seed.config.ts</code> and <code class="text-slate-300 font-mono">.env.example</code>.
            </p>
          </div>

          <div class="rounded-lg bg-slate-950 p-3.5 border border-slate-800/80 flex items-center justify-between font-mono text-xs">
            <span class="text-slate-200"><span class="text-emerald-400 select-none">$ </span>seed-db init</span>
            <button
              class="step-copy-btn text-slate-400 hover:text-emerald-400 transition-colors"
              data-cmd="seed-db init"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-6 space-y-4 flex flex-col justify-between shadow-lg">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
              STEP 2
            </span>
            <h3 class="font-mono text-lg font-bold text-white">Look before you seed</h3>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              See every table, its relationships, the insert order, and which generator each column will use.
            </p>
          </div>

          <div class="rounded-lg bg-slate-950 p-3.5 border border-slate-800/80 flex items-center justify-between font-mono text-xs">
            <span class="text-slate-200"><span class="text-emerald-400 select-none">$ </span>seed-db inspect</span>
            <button
              class="step-copy-btn text-slate-400 hover:text-emerald-400 transition-colors"
              data-cmd="seed-db inspect"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-6 space-y-4 flex flex-col justify-between shadow-lg">
          <div class="space-y-3">
            <span class="inline-block text-[11px] font-mono font-bold tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
              STEP 3
            </span>
            <h3 class="font-mono text-lg font-bold text-white">Seed it</h3>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Generate the data and insert it in one transaction. Add <code class="text-slate-300 font-mono">--check</code> to try it and roll it back.
            </p>
          </div>

          <div class="rounded-lg bg-slate-950 p-3.5 border border-slate-800/80 flex items-center justify-between font-mono text-xs">
            <span class="text-slate-200"><span class="text-emerald-400 select-none">$ </span>seed-db run</span>
            <button
              class="step-copy-btn text-slate-400 hover:text-emerald-400 transition-colors"
              data-cmd="seed-db run"
            >
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5-STAGE PIPELINE & KAHN'S ANIMATOR -->
  <section id="how-it-works" class="py-20 border-t border-slate-800/80 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- 5-Stage Heading -->
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Five stages, one direction.
        </h2>
        <p class="font-sans text-base text-slate-300 leading-relaxed">
          Only the first read of the schema and the final write touch your database. Everything in between is plain logic that gives the same answer every run.
        </p>
        <p class="font-sans text-xs text-slate-400 italic">
          It looks at how your tables connect, works out which ones must be filled first, then fills them from the top down.
        </p>
      </div>

      <!-- 5 Stages Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Stage 1 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 relative flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-emerald-400">1</div>
            <h4 class="font-mono text-sm font-bold text-white">Load config</h4>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Flags, <code class="text-slate-300">seed.config.ts</code> and <code class="text-slate-300">DATABASE_URL</code> become one set of options. A bad value stops here.
            </p>
          </div>
          <div class="hidden lg:block text-slate-600 font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 2 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 relative flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-emerald-400">2</div>
            <h4 class="font-mono text-sm font-bold text-white">Introspect</h4>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Read-only catalog queries turn tables, columns, keys and enums into one schema object.
            </p>
          </div>
          <div class="hidden lg:block text-slate-600 font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 3 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 relative flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-emerald-400">3</div>
            <h4 class="font-mono text-sm font-bold text-white">Order tables</h4>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Parents go before children. Ties break alphabetically, so the order never changes.
            </p>
          </div>
          <div class="hidden lg:block text-slate-600 font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 4 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 relative flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-emerald-400">4</div>
            <h4 class="font-mono text-sm font-bold text-white">Generate</h4>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Each column gets a generator once: your rule, then a foreign key, then a name match, then its type.
            </p>
          </div>
          <div class="hidden lg:block text-slate-600 font-mono text-right text-xs">→</div>
        </div>

        <!-- Stage 5 -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 relative flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-mono text-2xl font-bold text-emerald-400">5</div>
            <h4 class="font-mono text-sm font-bold text-white">Execute</h4>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Insert in batches inside one transaction, then fill any deferred links in a final patch pass.
            </p>
          </div>
          <div class="hidden lg:block text-emerald-500 font-mono text-right text-xs">✔</div>
        </div>
      </div>

      <!-- Kahn's Algorithm Animator -->
      <div class="pt-8 space-y-6">
        <div class="space-y-2 max-w-2xl">
          <h3 class="font-mono text-xl sm:text-2xl font-bold text-white tracking-tight">
            Watch the insert order
          </h3>
          <p class="font-sans text-sm text-slate-400 leading-relaxed">
            Five tables. <code class="text-slate-300 font-mono">employees</code> points at itself, because a manager is also an employee, so it goes in first with <code class="text-slate-300 font-mono">manager_id</code> empty. One update fills it at the end.
          </p>
        </div>

        <KahnAnimator />
      </div>
    </div>
  </section>

  <!-- EXAMPLES SECTION -->
  <section id="examples" class="py-20 border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3 max-w-3xl">
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Examples you can copy.
        </h2>
        <p class="font-sans text-base text-slate-400 leading-relaxed">
          Pick the situation you are in. Each one is a single command or a short file.
        </p>
      </div>

      <ExamplesWidget />
    </div>
  </section>

  <!-- CI & EXIT CODES SECTION -->
  <section id="ci" class="py-20 border-t border-slate-800/80 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Prove a schema change did not break seeding.
        </h2>
        <p class="font-sans text-base text-slate-300 leading-relaxed">
          Nothing prompts when output is not a terminal, exit codes are fixed, and every result and error can be printed as JSON for your pipeline to read.
        </p>
        <p class="font-sans text-xs text-slate-400 italic">
          Your automated checks can run it and know straight away whether seeding still works.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Terminal & JSON Block -->
        <div class="lg:col-span-6 space-y-4 font-mono text-xs">
          <div class="rounded-xl border border-slate-800 bg-[#090d16] p-5 space-y-3 shadow-lg">
            <div class="text-slate-500 text-[11px]">terminal</div>
            <div class="text-emerald-400 font-bold">
              seed-db run --check --seed 1 --format json
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950 p-5 space-y-2 shadow-lg text-slate-300">
            <div class="text-slate-500 text-[11px]">JSON response on error</div>
            <pre class="overflow-x-auto leading-relaxed text-slate-300">&#123;
  "error": &#123;
    "code": "E_UNSUPPORTED_TYPE",
    "where": "orders.total",
    "fix": "Add a rule for orders.total in seed.config.ts",
    "exit": 3
  &#125;
&#125;</pre>
          </div>
        </div>

        <!-- Right: Exit Codes Table -->
        <div class="lg:col-span-6 rounded-xl border border-slate-800 bg-[#090d16] overflow-hidden shadow-lg">
          <div class="px-5 py-3 border-b border-slate-800 bg-slate-900/60 font-mono text-xs font-bold text-slate-300 uppercase tracking-wider">
            Exit Codes
          </div>
          <div class="divide-y divide-slate-800/80 font-mono text-xs">
            <div class="p-4 flex items-start gap-4 hover:bg-slate-900/20 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">0</span>
              <span class="font-sans text-slate-300">Success, or a clean dry run</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-slate-900/20 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-amber-500/15 text-amber-400 border border-amber-500/20">1</span>
              <span class="font-sans text-slate-300">Runtime or database error; transaction rolled back</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-slate-900/20 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-amber-500/15 text-amber-400 border border-amber-500/20">2</span>
              <span class="font-sans text-slate-300">Usage or config error: bad flag, missing URL, invalid config</span>
            </div>
            <div class="p-4 flex items-start gap-4 hover:bg-slate-900/20 transition-colors">
              <span class="px-2 py-0.5 rounded font-bold bg-rose-500/15 text-rose-400 border border-rose-500/20">3</span>
              <span class="font-sans text-slate-300">Schema problem: unbreakable circular dependency, unsupported required column type</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCOPE COMPARISON SECTION -->
  <section class="py-20 border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="space-y-4 max-w-3xl">
        <PillBadge text="IN PLAIN WORDS" />
        <h2 class="font-mono text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Version 1 is small on purpose.
        </h2>
        <p class="font-sans text-base text-slate-300 leading-relaxed">
          PostgreSQL only, one schema per run. The first release does a few things and does them safely.
        </p>
        <p class="font-sans text-xs text-slate-400 italic">
          Version 1 covers the common cases first. The rest comes once real schemas need it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- In Version 1 -->
        <div class="rounded-xl border border-emerald-500/30 bg-[#090d16] p-6 space-y-4 shadow-lg shadow-emerald-950/10">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="font-mono text-base font-bold text-emerald-400">In version 1</h3>
            <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Ready</span>
          </div>

          <ul class="space-y-2.5 font-sans text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>Single-column foreign keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>Type mapping and a short list of name matches</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>One transaction per run (all-or-nothing atomicity)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span><code class="font-mono text-emerald-300">--dry-run</code>, <code class="font-mono text-emerald-300">--check</code> and <code class="font-mono text-emerald-300">--out</code></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>Snapshots from <code class="font-mono text-emerald-300">inspect --json</code></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>Circular tables, filled in afterwards (2-phase patch pass)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400 font-mono">✔</span>
              <span>Errors with a code, location, cause, and concrete fix</span>
            </li>
          </ul>
        </div>

        <!-- Later -->
        <div class="rounded-xl border border-slate-800 bg-[#090d16] p-6 space-y-4 shadow-lg opacity-80">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="font-mono text-base font-bold text-slate-400">Later</h3>
            <span class="text-xs font-mono text-slate-500 bg-slate-800 px-2 py-0.5 rounded">Roadmap</span>
          </div>

          <ul class="space-y-2.5 font-sans text-xs text-slate-400">
            <li class="flex items-center gap-2">
              <span class="text-slate-600 font-mono">•</span>
              <span>Multi-column foreign keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-slate-600 font-mono">•</span>
              <span>Reading a schema file, with an in-process Postgres</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-slate-600 font-mono">•</span>
              <span>More name matches and dictionary heuristics</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-slate-600 font-mono">•</span>
              <span><code class="font-mono">--truncate</code> and resume after failure</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-slate-600 font-mono">•</span>
              <span>MySQL and SQLite dialect adapters</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupStepCopyButtons() {
    const btns = document.querySelectorAll('.step-copy-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-cmd');
        if (cmd) {
          navigator.clipboard.writeText(cmd);
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = orig;
          }, 2000);
        }
      });
    });
  }

  setupStepCopyButtons();
  document.addEventListener('astro:page-load', setupStepCopyButtons);
</script>
